# ==========================================
# BNPL Microservices - Environment Variables
# ==========================================

# Database Configuration
DB_PASSWORD=yourStrongDbPasswordHere
SPRING_FLYWAY_ENABLED=true

# Security & Inter-Service Authentication
JWT_SECRET=bnpl-super-secret-security-key-for-jwt-signing-2026-production
INTERNAL_SERVICE_SECRET=bnpl-internal-system-secret-2026

# Payment Gateway Configuration
# Mode: "LIVE" (calls api.razorpay.com) or "SANDBOX" (offline simulated mode)
PAYMENT_GATEWAY_MODE=SANDBOX

# Razorpay Test Credentials (from dashboard.razorpay.com -> Settings -> API Keys)
RAZORPAY_KEY_ID=rzp_test_yourActualKeyIdHere
RAZORPAY_KEY_SECRET=yourActualKeySecretHere
RAZORPAY_WEBHOOK_SECRET=yourWebhookSecretHere

# Stripe Test Credentials (Optional)
STRIPE_API_KEY=sk_test_bnpl2026demo

# Kafka & Zipkin
SPRING_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
MANAGEMENT_ZIPKIN_TRACING_ENDPOINT=http://localhost:9411/api/v2/spans
